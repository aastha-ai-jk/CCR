# Copy to .env.compose in the repo root and edit; used as:
#   docker compose --env-file .env.compose up -d --build
# UID that owns ./data and ./models on the host (GPU box: `id -u antpc`)
APP_UID=1000
# Host ports (the GPU box uses 8010 / 3010 today)
BACKEND_PORT=8010
FRONTEND_PORT=3010
# Address the CCR screens' browsers use to reach the backend
PUBLIC_API_BASE=http://10.53.2.10:8010
