# CCR Kiln-3 twin — Next.js dashboard (Live Overview, Digital Twin, Simulator, ...).
# NEXT_PUBLIC_API_BASE is baked in at build time: the address the BROWSER uses to
# reach the backend (e.g. http://10.53.2.10:8010), not a container-internal name.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ARG NEXT_PUBLIC_API_BASE=http://localhost:8010
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE} \
    NEXT_TELEMETRY_DISABLED=1
RUN rm -f .env.local && npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app ./
USER node
EXPOSE 3010
CMD ["npx", "next", "start", "-H", "0.0.0.0", "-p", "3010"]
