# Copy to .env.secrets (git ignores it) and fill in. Never put real keys in .env,
# which is committed. Loaded by config.py after .env and overrides it.

# Advisor "why" text via LLM (twin/reasoning.py); off unless a provider is set.
# Claude Haiku 5.5 chosen 27 Oct 2026 (gpt-5-nano not available).
REASONING_PROVIDER=anthropic
REASONING_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=sk-ant-...your key...
# OpenAI alternative: REASONING_PROVIDER=openai, REASONING_MODEL=gpt-5-nano
OPENAI_API_KEY=