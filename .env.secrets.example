# Copy to .env.secrets (git ignores it) and fill in. Never put real keys in .env,
# which is committed. Loaded by config.py after .env and overrides it.

# Advisor "why" text via LLM (twin/reasoning.py); off unless a provider is set.
# 29 Oct 2026: Claude Haiku 4.5 through the company's Amazon Bedrock account
# (Bedrock API key, starts ABSK). Haiku 5.5 / GPT-5 nano were not available.
REASONING_PROVIDER=bedrock
REASONING_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=ap-south-1
BEDROCK_API_KEY=ABSK...your key...
# Alternatives: REASONING_PROVIDER=anthropic + ANTHROPIC_API_KEY (sk-ant-...),
#               REASONING_PROVIDER=openai + OPENAI_API_KEY (sk-proj-...)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Daily report email (python -m backend.daily_report) — plant SMTP from IT
SMTP_HOST=
SMTP_PORT=25
SMTP_STARTTLS=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_TO=
