# Copy to .env.secrets (git ignores it) and fill in. Never put real keys in .env,
# which is committed. Loaded by config.py after .env and overrides it.

# Advisor "why" text via LLM (twin/reasoning.py); off unless set to openai.
REASONING_PROVIDER=openai
REASONING_MODEL=gpt-5-nano
OPENAI_API_KEY=sk-proj-...your key...
