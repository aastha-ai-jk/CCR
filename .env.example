# Copy this file to .env and fill in your PostgreSQL password.
# The whole data layer is driven by DATABASE_URL — change this one line to
# point ingestion + the API at Postgres, SQLite, or any other backend.

# --- PostgreSQL (target) ---
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/digital_twin

# --- SQLite fallback (used automatically by ETL if USE_SQLITE=1) ---
# Lets everything run before Postgres credentials are confirmed.
USE_SQLITE=0
SQLITE_PATH=./data/digital_twin.sqlite

# --- Raw data source directories (already on this machine) ---
# --- Fuel economics (optional; for the savings breakdown) ---
# Leave prices unset/0 -> the app shows ENERGY, TSR and kcal/kg only and no money
# figure (nothing is ever fabricated). Fuel prices can also be entered directly
# in the UI ("set fuel prices"), which is stored per-browser.
CURRENCY=INR
COAL_PRICE_PER_T=0
KILN_COAL_PRICE_PER_T=0
LAFR_PRICE_PER_L=0
SAFR_PRICE_PER_T=0
# Calorific values (kcal/kg) and liquid-AFR density (kg/l)
COAL_CV_KCAL_KG=5200
AFR_LIQ_CV_KCAL_KG=2500
AFR_SOL_CV_KCAL_KG=2500
LAFR_DENSITY_KG_PER_L=1.0
# clinker produced per tonne of kiln feed (for kcal/kg-clinker reporting)
CLINKER_PER_FEED=0.63

PLC_DIR=D:/PLC Historical Data
HOTMEAL_DIR=D:/hotmeal
QC_DIR=D:/QC_NBH
OPC_DIR=D:/OPC
TAGS_XLSX=D:/QC_NBH/PLC & QC Data and Tags (1).xlsx
